# PostgreSQL connection string the app queries through at runtime.
# Local Postgres: same URL for both. Supabase/Neon in production: this is the
# POOLED connection string (Supabase: "Transaction" mode, port 6543).
DATABASE_URL="postgresql://pulsecheck:pulsecheck_dev@localhost:5432/pulsecheck"

# Direct (unpooled) connection string, used only for `prisma migrate`.
# Local Postgres: same value as DATABASE_URL. Supabase: the direct connection
# string (port 5432) from Project Settings > Database.
DIRECT_URL="postgresql://pulsecheck:pulsecheck_dev@localhost:5432/pulsecheck"

# Secret used to sign moderator session cookies (swap for Clerk/Supabase in prod — see README)
AUTH_SECRET="change-me-to-a-long-random-string"
