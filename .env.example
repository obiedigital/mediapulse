# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# Model used for bulk per-article classification/sentiment/entity/summary calls
MEDIAPULSE_CLASSIFY_MODEL=claude-sonnet-4-6
# Stronger model reserved for daily/weekly brief synthesis and Ask MediaPulse RAG answers
MEDIAPULSE_SYNTHESIS_MODEL=claude-opus-4-8
# Vision-capable model for print PDF page segmentation fallback
MEDIAPULSE_VISION_MODEL=claude-sonnet-4-6

# --- Database ---
# Local dev default is SQLite; production should point at Postgres
MEDIAPULSE_DATABASE_URL=sqlite:///./mediapulse.db

# --- SMTP (Daily Brief email delivery) ---
# Two conventions, don't mix them:
#   port 587 + MEDIAPULSE_SMTP_USE_TLS=true   -> STARTTLS (upgrades a plaintext connection)
#   port 465 + MEDIAPULSE_SMTP_USE_SSL=true   -> implicit TLS from the first byte
# e.g. a cPanel-style host offering only 465 (mail.example.com, SMTP port 465):
#   MEDIAPULSE_SMTP_HOST=mail.example.com
#   MEDIAPULSE_SMTP_PORT=465
#   MEDIAPULSE_SMTP_USE_SSL=true
#   MEDIAPULSE_SMTP_USE_TLS=false
MEDIAPULSE_SMTP_HOST=
MEDIAPULSE_SMTP_PORT=587
MEDIAPULSE_SMTP_USER=
MEDIAPULSE_SMTP_PASSWORD=
MEDIAPULSE_SMTP_FROM=briefs@mediapulse.bw
MEDIAPULSE_SMTP_USE_TLS=true
MEDIAPULSE_SMTP_USE_SSL=false

# --- App ---
MEDIAPULSE_ENV=development
# JWT signing key — set to a long random value in production (e.g. `openssl rand -hex 32`)
MEDIAPULSE_SECRET_KEY=change-me
MEDIAPULSE_LOG_LEVEL=INFO

# --- Scheduler (mediapulse scheduler / docker-compose's `scheduler` service) ---
MEDIAPULSE_SCHEDULER_INGEST_INTERVAL_MINUTES=30
MEDIAPULSE_SCHEDULER_CLASSIFY_INTERVAL_MINUTES=15
MEDIAPULSE_SCHEDULER_ALERTS_INTERVAL_MINUTES=60
